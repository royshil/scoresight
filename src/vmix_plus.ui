<ui version="4.0">
 <class>VMixPlusPage</class>
 <widget class="QWidget" name="VMixPlusPage">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLabel" name="label_intro"><property name="text"><string>Update every vMix title with matching field names, including titles that are off air.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><layout class="QHBoxLayout" name="connectionLayout">
    <item><widget class="QLabel" name="label_connection"><property name="text"><string>Connection</string></property><property name="buddy"><cstring>lineEdit_host</cstring></property></widget></item>
    <item><widget class="QLineEdit" name="lineEdit_host"><property name="placeholderText"><string>localhost</string></property></widget></item>
    <item><widget class="QLabel" name="label_separator"><property name="text"><string notr="true">:</string></property></widget></item>
    <item><widget class="QLineEdit" name="lineEdit_port"><property name="maximumSize"><size><width>70</width><height>16777215</height></size></property><property name="accessibleName"><string>Web API port</string></property><property name="toolTip"><string>Web API port for finding fields. Live values use the fixed TCP port 8099.</string></property></widget></item>
    <item><widget class="QPushButton" name="pushButton_start"><property name="text"><string>Start vMix API+</string></property><property name="checkable"><bool>true</bool></property></widget></item>
   </layout></item>
   <item><layout class="QHBoxLayout" name="discoveryLayout">
    <item><widget class="QPushButton" name="pushButton_fetch"><property name="text"><string>Fetch fields</string></property><property name="toolTip"><string>Find text fields in all vMix inputs. Fields are also refreshed every five seconds while this output is on.</string></property></widget></item>
    <item><widget class="QLabel" name="label_fields"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property><property name="textFormat"><enum>Qt::PlainText</enum></property></widget></item>
   </layout></item>
   <item><widget class="QLabel" name="label_transport"><property name="text"><string>Fields: HTTP port above. Live updates: TCP 8099.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item><widget class="QCheckBox" name="checkBox_sendSame"><property name="text"><string>Also resend unchanged values</string></property></widget></item>
   <item><widget class="QTableView" name="tableView_mapping"><property name="toolTip"><string>Choose an exact vMix text-field name, including .Text for GT titles. Every matching title receives the value. Clear a mapping to stop sending it.</string></property><property name="alternatingRowColors"><bool>true</bool></property></widget></item>
  </layout>
