                       <string>Send the field names in lower case with letters, digits and _ only ("Home Score" as home_score), for receivers that allow no other names</string>
                      </property>
                      <property name="text">
                       <string>Letters, digits and _ only</string>
                      </property>
                     </widget>
                    </item>
                    <item row="10" column="1">
