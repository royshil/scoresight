           <item row="1" column="1">
            <widget class="QComboBox" name="comboBox_ocrModel">
             <property name="accessibleName">
              <string>OCR model</string>
             </property>
             <property name="toolTip">
              <string>The OCR model that reads every box, not only the selected one. PP-OCR (automatic) reads with PP-OCR (accurate) while this computer keeps up, and with PP-OCR (fast), which needs about a fifth of the CPU, when it doesn't. The Tesseract models use the boxes' Image cleanup settings; Load external Tesseract model... reads a .traineddata file.</string>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="label_detectionCadence">
             <property name="toolTip">
              <string>How many times per second the boxes are read</string>
             </property>
