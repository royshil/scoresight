              <widget class="QSlider" name="horizontalSlider_detectionCadence">
               <property name="accessibleName">
                <string>Detections per second</string>
               </property>
               <property name="toolTip">
                <string>How many times per second the boxes are read (1-15). Higher values use more CPU; 5 suits most clocks.</string>
               </property>
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>15</number>
               </property>
               <property name="pageStep">
